{
  "name": "studio-live",
  "productName": "MyStudioLive",
  "version": "1.0.0",
  "description": "MyStudioLive — cảnh tương tác cho TikTok LIVE: Live Ma Online, Đi Chùa Online, Rạp Phim Online, Vua Tiếng Việt & Kéo Co Online",
  "main": "src/main.js",
  "scripts": {
    "build:css": "tailwindcss -i renderer/tailadmin/app.css -o renderer/app.css --minify",
    "watch:css": "tailwindcss -i renderer/tailadmin/app.css -o renderer/app.css --watch",
    "prestart": "npm run build:css",
    "start": "electron .",
    "predist:mac": "npm run build:css",
    "dist:mac": "electron-builder --mac",
    "predist:win": "npm run build:css",
    "dist:win": "electron-builder --win"
  },
  "author": "Tanthuan031 (https://github.com/tanthuan031)",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "msedge-tts": "^2.1.0",
    "socket.io": "^4.8.1",
    "three": "0.160.1",
    "tiktok-live-connector": "2.0.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/forms": "^0.5.11",
    "electron": "45.2.1",
    "electron-builder": "^26.0.12",
    "@openapitools/openapi-generator-cli": "file:stubs/unused-dependency",
    "protobufjs": "file:stubs/unused-dependency",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "@openapitools/openapi-generator-cli": "$@openapitools/openapi-generator-cli",
    "protobufjs": "$protobufjs"
  },
  "build": {
    "appId": "vn.studiolive.app",
    "productName": "MyStudioLive",
    "copyright": "© 2026 Tanthuan031",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "overlay/**/*",
      "vua/**/*",
      "!vua/test/**",
      "keoco/**/*",
      "!keoco/test/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "MyStudioLive-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "MyStudioLive ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyStudioLive",
      "artifactName": "MyStudioLive-Setup-${version}-win-x64.${ext}"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "docs/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "docs/HUONG-DAN-CAI-DAT.md",
        "to": "HUONG-DAN-CAI-DAT.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "DISCLAIMER.md",
        "to": "DISCLAIMER.md"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tanthuan031/StudioLive.git"
  },
  "homepage": "https://github.com/tanthuan031/StudioLive"
}
